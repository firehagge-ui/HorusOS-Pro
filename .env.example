# ==============================================================================
# Configurações de Publicação e Integrações do Horus OS
# Copie este arquivo para .env e preencha seus valores.
# ==============================================================================

# Meta Graph API (Instagram Business & Facebook Page)
# Guia passo a passo em marketing/automacao-meta-setup.md
META_PAGE_ACCESS_TOKEN=seu_meta_token_de_longa_duracao_aqui
META_PAGE_ID=seu_id_da_pagina_facebook
META_IG_USER_ID=seu_id_da_conta_instagram_business

# URL pública do site onde as imagens dos posts ficam hospedadas
# Ex: https://suaempresa.com.br ou https://seuapp.netlify.app
SITE_URL=https://suaempresa.com.br
